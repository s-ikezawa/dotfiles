#!/usr/bin/env bash
{{ template "lib.sh" }}

# dotfiles を配置する前に、XDG のベースディレクトリを用意しておく。
# 特に zsh の cache/data/state 配下は誰も自動生成しないため、ここで先に掘る。
XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

log "XDG ディレクトリを作成"
mkdir -p \
  "${XDG_CONFIG_HOME}/zsh" \
  "${XDG_CACHE_HOME}/zsh" \
  "${XDG_DATA_HOME}/zsh" \
  "${XDG_STATE_HOME}/zsh" \
  "${HOME}/.local/bin"
