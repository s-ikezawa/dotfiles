{{- /*
  chezmoi の設定ファイル (~/.config/chezmoi/chezmoi.toml) を生成するテンプレート。
  公開リポジトリに置きたくない個人情報は、ここで初回の chezmoi init 時に入力させ、
  ローカルの chezmoi.toml にだけ保存する。2 回目以降は保存済みの値が使われる。
*/ -}}
{{- $gitName := promptStringOnce . "git.name" "Git user.name" -}}
{{- $gitEmail := promptStringOnce . "git.email" "Git user.email（プライベート用 github.com/s-ikezawa）" -}}
{{- $gitWorkEmail := promptStringOnce . "git.workEmail" "Git user.email（会社用 github.com/ebisol）" -}}

[data.git]
name = {{ $gitName | quote }}
email = {{ $gitEmail | quote }}
workEmail = {{ $gitWorkEmail | quote }}
