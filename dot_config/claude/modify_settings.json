#!/bin/bash
# Claude Code は settings.json を自分で書き換える (theme, model など)。
# ファイル丸ごとは管理せず、ここで指定したキーだけを既存の内容にマージする。
set -euo pipefail

current=$(cat)
[ -n "$current" ] || current='{}'

printf '%s\n' "$current" | /usr/bin/jq '
  # ステータスラインを表示
  .statusLine = {
    type: "command",
    command: "~/.config/claude/scripts/statusline.sh"
  }
  # セッションを auto mode で始める。
  # プロジェクトの .claude/settings.json では auto が効かないため、ユーザー設定に置く。
  | .permissions.defaultMode = "auto"
  # Claude が下書きしたフィードバックの送信カード（1: review / 2: send）を出さない。
  # SendFeedback ツールごと外れる。settings の feedbackDrafts: "off" と同じ効果。
  | .env.CLAUDE_CODE_SEND_FEEDBACK = "0"
  # "How is Claude doing?" のセッション評価アンケートを出さない。
  | .env.CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY = "1"
  # 入力欄に次のプロンプトの候補を出さない。
  | .env.CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION = "false"
  # 組み込みの差分パネル（/diff の右側ペイン。編集時に自動で開く）を出さない。
  # 差分は Neovim や hunk で確認する。/plugin の Installed タブで無効にしたときと同じ。
  # キーは外向きの名前 diff@builtin。内部名の cc-plugin-diff@builtin では効かない。
  | .enabledPlugins["diff@builtin"] = false
  | del(.enabledPlugins["cc-plugin-diff@builtin"])
'
