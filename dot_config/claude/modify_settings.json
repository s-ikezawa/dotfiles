#!/bin/bash
# Claude Code は settings.json を自分で書き換える (theme, model など)。
# ファイル丸ごとは管理せず、ここで指定したキーだけを既存の内容にマージする。
set -euo pipefail

current=$(cat)
[ -n "$current" ] || current='{}'

printf '%s\n' "$current" | /usr/bin/jq '
  .statusLine = {
    type: "command",
    command: "~/.config/claude/scripts/statusline.sh"
  }
  # セッションを auto mode で始める。
  # プロジェクトの .claude/settings.json では auto が効かないため、ユーザー設定に置く。
  | .permissions.defaultMode = "auto"
  # claude.ai から同期される Anthropic 製スキルのうち、使わないものを隠す。
  # 同期は止めずに skillOverrides で一覧と / メニューから外す。
  | .skillOverrides += {
      "anthropic-skills:docs": "off",
      "anthropic-skills:docx": "off",
      "anthropic-skills:pptx": "off",
      "anthropic-skills:xlsx": "off",
      "anthropic-skills:pdf": "off",
      "anthropic-skills:morning": "off",
      "anthropic-skills:import-memory": "off"
    }
  # claude.ai アカウントから降ってくる MCP コネクタのうち Claude Docs を止める。
  # ローカルの mcpServers には載らない(Claude Code が自分で取得する)ので
  # `claude mcp remove` では消せず、設定側で拒否する必要がある。
  # serverName は `claude mcp list` の表示名そのまま。
  # 全コネクタを止める disableClaudeAiConnectors は使わない(他が来た時に巻き添えになる)。
  | .deniedMcpServers = (
      (.deniedMcpServers // []) + [{ serverName: "claude.ai Claude Docs" }] | unique
    )
  # auto mode の "Bash 優先" ステアを無効化する。
  # これが有効だとファイル読み込みが cat/grep になり、サブディレクトリの
  # CLAUDE.md や .claude/rules (paths スコープ) が発火しない。
  # Read/Edit/Write を使わせるために内部フラグ thrifty_sonic を明示的に切る。
  | .env.CLAUDE_CODE_THRIFTY_SONIC = "0"
  # Claude が下書きしたフィードバックの送信カード（1: review / 2: send）を出さない。
  # SendFeedback ツールごと外れる。settings の feedbackDrafts: "off" と同じ効果。
  | .env.CLAUDE_CODE_SEND_FEEDBACK = "0"
  # "How is Claude doing?" のセッション評価アンケートを出さない。
  | .env.CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY = "1"
  # 入力欄に次のプロンプトの候補を出さない。
  | .env.CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION = "false"
'
