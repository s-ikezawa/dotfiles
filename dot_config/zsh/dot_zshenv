# ---------------------------------------------------------------------------
# System
# ---------------------------------------------------------------------------
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
export LANG=en_US.UTF-8
export SHELL_SESSIONS_DISABLE=1
export LESSHISTFILE="${XDG_STATE_HOME:-$HOME/.local/state}/less/history"

# ---------------------------------------------------------------------------
# Homebrew(brew shellenv はサブプロセスを起こすので既定パスを直接指定する)
# ---------------------------------------------------------------------------
export HOMEBREW_PREFIX=/opt/homebrew

# ---------------------------------------------------------------------------
# Claude Code
# ---------------------------------------------------------------------------
export CLAUDE_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/claude"

# ---------------------------------------------------------------------------
# Android
# ---------------------------------------------------------------------------
# 既定では SDK が ~/Library/Android/sdk、SDK ツールのユーザーデータ(Android CLI の本体・
# AVD・リポジトリのキャッシュ・debug.keystore)が ~/.android に分かれるので、XDG_DATA_HOME の
# 下の 1 か所にまとめる。SDK はデータなので ~/.local/bin ではなく ~/.local/share に置く。
# adb の鍵(adbkey)と Gradle の analytics.settings は ANDROID_USER_HOME を見ずに ~/.android へ書く。
export ANDROID_USER_HOME="${XDG_DATA_HOME}/android"
export ANDROID_HOME="${ANDROID_USER_HOME}/sdk"
# 公式ドキュメント上は ANDROID_USER_HOME が既定値だが、emulator 37.1.11 は AVD を
# $ANDROID_AVD_HOME → $ANDROID_SDK_HOME/avd → ~/.android/avd の順にしか探さない。
# android emulator create は $ANDROID_USER_HOME/avd に作るので、明示しないと起動できない。
# ANDROID_AVD_HOME の既定値は $ANDROID_EMULATOR_HOME/avd なので、これ 1 つで揃う。
export ANDROID_EMULATOR_HOME="${ANDROID_USER_HOME}"

# ---------------------------------------------------------------------------
# Node / npm / pnpm
# ---------------------------------------------------------------------------
# npm は環境変数 NPM_CONFIG_<KEY>(= .npmrc の <key>)を設定として読む。
# 既定ではグローバルの入り先(prefix)が node の実体の中(mise の installs/node/<version>)に
# なるため、node を上げるたびにグローバルパッケージを入れ直すことになる。
# あわせて ~/.npmrc と ~/.npm(キャッシュ)も XDG の下へ移す。ディレクトリは npm が自分で掘る。
export NPM_CONFIG_PREFIX="${XDG_DATA_HOME}/npm"                  # npm i -g の入り先。コマンドは $NPM_CONFIG_PREFIX/bin
export NPM_CONFIG_CACHE="${XDG_CACHE_HOME}/npm"                  # 実行ログ(_logs)もこの下
export NPM_CONFIG_USERCONFIG="${XDG_CONFIG_HOME}/npm/npmrc"      # 既定は ~/.npmrc
export NPM_CONFIG_INIT_MODULE="${XDG_CONFIG_HOME}/npm/init.js"   # npm init の雛形。既定は ~/.npm-init.js

# pnpm は XDG_* が設定されていれば macOS でも ~/Library ではなくその下を使うので、
# 環境変数は要らず PATH を通すだけでよい(pnpm 12.4.1 で確認)。
#   グローバル  $XDG_DATA_HOME/pnpm/bin, $XDG_DATA_HOME/pnpm/global
#   ストア      $XDG_DATA_HOME/pnpm/store
#   キャッシュ  $XDG_CACHE_HOME/pnpm
# PNPM_HOME を設定するとそこが直接グローバルの bin になり、store などと同じ階層に混ざるので設定しない。

# node の REPL 履歴。既定は ~/.node_repl_history。
export NODE_REPL_HISTORY="${XDG_STATE_HOME}/node/repl_history"

# ---------------------------------------------------------------------------
# PATH
# ---------------------------------------------------------------------------
typeset -U path fpath

# macOS の /etc/zprofile は path_helper を実行して PATH を /etc/paths から組み直し、
# ここで先頭に置いたパスを末尾へ回してしまう。ログインシェルでは ~/.zprofile が
# path_helper の後に読まれるので、そこからこの関数を呼び直して順序を戻す。
# .zshenv と .zprofile で定義が二重にならないよう関数にまとめている。
#
# .zshenv 側でも PATH を組むのは、スクリプトなど非ログイン・非対話シェルでも
# GNU 版コマンドや mise のツールを使えるようにするため。
_zsh_setup_path() {
  path=(
    "$HOME/.local/bin"
    "$HOME/bin"
    "${XDG_DATA_HOME}/mise/shims"
    # npm i -g / pnpm add -g で入れたコマンド。mise の shims より後ろに置いて、
    # mise が管理しているツールを上書きしないようにする。
    # pnpm はグローバルの bin が PATH に無いと pnpm add -g 自体をエラーにする。
    "${XDG_DATA_HOME}/npm/bin"
    "${XDG_DATA_HOME}/pnpm/bin"
    # GNU 版コマンド(coreutils / gnu-sed / grep / findutils など)を BSD 版より優先する。
    # gnubin には g 接頭辞なしの名前(ls, sed, grep ...)で入る。(N) は該当なしでもエラーにしない。
    $HOMEBREW_PREFIX/opt/*/libexec/gnubin(N)
    "$HOMEBREW_PREFIX/bin"
    "$HOMEBREW_PREFIX/sbin"
    # adb など。SDK パッケージを入れる前は存在しないが、PATH にあっても害はない。
    "$ANDROID_HOME/platform-tools"
    "$ANDROID_HOME/emulator"
    $path
  )
}
_zsh_setup_path
