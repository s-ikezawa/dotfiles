# XDG Base Directory
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

# ロケール。/etc/zprofile は LANG が空のときだけ C.UTF-8 を入れるが、それは
# ログインシェルのみ。ここで設定しておかないと非ログインシェルが LANG 無しになり、
# 日本語ファイル名やマルチバイト入力が壊れることがある。
# GNU ツールのメッセージを英語のままにしたいので ja_JP ではなく en_US を使う。
export LANG=en_US.UTF-8

# Claude Code
export CLAUDE_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/claude"

# Terminal.app 用のセッション復元（~/.config/zsh/.zsh_sessions にセッションごとの
# ヒストリを溜める）を止める。/etc/zshrc から /etc/zshrc_Apple_Terminal が
# .zshrc より先に読まれるので、.zshrc ではなくここで設定する必要がある。
export SHELL_SESSIONS_DISABLE=1

# less のヒストリ。放っておくと ~/.lesshst を作る（git のページャ経由でも作られる）。
# less はディレクトリを掘らないので、.zshrc 側で mkdir している。
export LESSHISTFILE="${XDG_STATE_HOME:-$HOME/.local/state}/less/history"

# ---------------------------------------------------------------------------
# コンテナ（colima / docker）
#
# docker CLI の設定・認証情報・context の置き場。既定は ~/.docker。
# CLI プラグインの探索先も $DOCKER_CONFIG/cli-plugins になるので、mise の
# docker-compose の postinstall（config.toml）が張る symlink 先と揃えてある。
#
# **colima を起動する前に効いている必要がある。** colima は起動のたびに
# docker context を作って active にするが、書き込み先はこの変数で決まる。
# 未設定のまま起動すると ~/.docker 側に context ができ、後から XDG に寄せた
# 瞬間に context を見失う。
export DOCKER_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/docker"

# LIMA_HOME は**設定しない**。colima は自分の VM を $COLIMA_HOME/_lima に作るが、
# 環境に LIMA_HOME があるとそちらを見に行き、`colima is not running` になる
# （XDG に寄せようとして踏んだ。lima を単体で使うようになったら考え直す）。

# colima 自身に置き場を変える環境変数は無い。~/.colima があればそちらを、
# 無ければ XDG 配下（~/.config/colima）を使う。**~/.colima を作らないこと。**
# 実際の場所は `colima template --print` で確認できる。

# DOCKER_HOST も設定しない。docker CLI は colima が張る context から socket を
# 見つけられるし、DOCKER_HOST があると context より優先されて
# `docker context ls` が警告を出す。context を読まないツール（Testcontainers など）
# を使うようになったら、そのときに socket の存在を見て足す。

# Homebrew(brew shellenv はサブプロセスを起こすので既定パスを直接指定する)
export HOMEBREW_PREFIX=/opt/homebrew

# ---------------------------------------------------------------------------
# PATH
#
# path は $PATH と連動する配列。-U を付けると重複が自動で除去される(先勝ち)。
typeset -U path fpath

# macOS の /etc/zprofile は path_helper を実行して PATH を /etc/paths から組み直し、
# ここで先頭に置いたパスを末尾へ回してしまう。ログインシェルでは ~/.zprofile が
# path_helper の後に読まれるので、そこからこの関数を呼び直して順序を戻す。
# .zshenv と .zprofile で定義が二重にならないよう関数にまとめている。
#
# .zshenv 側でも PATH を組むのは、スクリプトなど非ログイン・非対話シェルでも
# GNU 版コマンドや mise のツールを使えるようにするため。
_zsh_setup_path() {
  path=(
    "$HOME/.local/bin"
    "$HOME/bin"
    "${XDG_DATA_HOME}/mise/shims"
    # GNU 版コマンド(coreutils / gnu-sed / grep / findutils など)を BSD 版より優先する。
    # gnubin には g 接頭辞なしの名前(ls, sed, grep ...)で入る。(N) は該当なしでもエラーにしない。
    $HOMEBREW_PREFIX/opt/*/libexec/gnubin(N)
    "$HOMEBREW_PREFIX/bin"
    "$HOMEBREW_PREFIX/sbin"
    $path
  )
}
_zsh_setup_path
