# ---------------------------------------------------------------------------
# System
# ---------------------------------------------------------------------------
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
# XDG の仕様には無いが、ユーザーの実行ファイル置き場として広く使われている変数。
# uv が `uv tool install` のリンク先に使う。未設定でも $XDG_DATA_HOME/../bin に落ちて
# 同じ場所になるが、PATH に入れている場所と一致させて明示しておく。
export XDG_BIN_HOME="${XDG_BIN_HOME:-$HOME/.local/bin}"
export LANG=en_US.UTF-8
export SHELL_SESSIONS_DISABLE=1
# git のコミットメッセージなどを書くエディタ（Neovim は mise で入れる）
export EDITOR=nvim
export LESSHISTFILE="${XDG_STATE_HOME:-$HOME/.local/state}/less/history"

# ---------------------------------------------------------------------------
# Homebrew(brew shellenv はサブプロセスを起こすので既定パスを直接指定する)
# ---------------------------------------------------------------------------
export HOMEBREW_PREFIX=/opt/homebrew

# ---------------------------------------------------------------------------
# Claude Code
# ---------------------------------------------------------------------------
export CLAUDE_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/claude"

# ---------------------------------------------------------------------------
# Node.js / npm / pnpm（本体は mise で入れる）
# ---------------------------------------------------------------------------
# npm は XDG に従わないので、置き場所を環境変数で指定する。
export NPM_CONFIG_USERCONFIG="$XDG_CONFIG_HOME/npm/npmrc" # 設定（既定は ~/.npmrc）
export NPM_CONFIG_CACHE="$XDG_CACHE_HOME/npm"             # キャッシュ（既定は ~/.npm）
# npm install -g の入れ先（既定は Node.js の版のフォルダで、Node.js を上げると消える）。
# 実行ファイルは $NPM_CONFIG_PREFIX/bin に入る（PATH に入れる）。
export NPM_CONFIG_PREFIX="$XDG_DATA_HOME/npm"
export NODE_REPL_HISTORY="$XDG_STATE_HOME/node_repl_history" # node の対話モードの履歴（既定は ~/.node_repl_history）
# pnpm add -g の入れ先（実行ファイルもここに入る。PATH に入れる）。
# 設定・キャッシュ・ストアは、XDG_CONFIG_HOME などが設定されていればその下（pnpm/）に置かれる。
export PNPM_HOME="$XDG_DATA_HOME/pnpm"

# ---------------------------------------------------------------------------
# Go（本体は mise で入れる）
# ---------------------------------------------------------------------------
export GOPATH="$XDG_DATA_HOME/go"           # go install の入れ先は $GOPATH/bin（既定は ~/go）
export GOMODCACHE="$XDG_CACHE_HOME/go/mod"  # ダウンロードしたモジュール（既定は $GOPATH/pkg/mod）
export GOCACHE="$XDG_CACHE_HOME/go-build"   # ビルドのキャッシュ（既定は ~/Library/Caches/go-build）
export GOENV="$XDG_CONFIG_HOME/go/env"      # go env -w の書き込み先（既定は ~/Library/Application Support/go/env）

# ---------------------------------------------------------------------------
# Gradle（Kotlin のプロジェクトのビルドに使う。Java は mise で入れる）
# ---------------------------------------------------------------------------
# ダウンロードした依存やラッパーの Gradle 本体、デーモンの置き場所（既定は ~/.gradle）。
# キャッシュと設定（gradle.properties）が同じフォルダに入り分けられないので、data に置く。
export GRADLE_USER_HOME="$XDG_DATA_HOME/gradle"

# ---------------------------------------------------------------------------
# AWS CLI（mise で入れる）
# ---------------------------------------------------------------------------
# 設定と認証情報の置き場所（既定はどちらも ~/.aws）。SSO のトークンなどのキャッシュは
# 変えられず ~/.aws/sso・~/.aws/cli に作られる。
export AWS_CONFIG_FILE="$XDG_CONFIG_HOME/aws/config"
export AWS_SHARED_CREDENTIALS_FILE="$XDG_CONFIG_HOME/aws/credentials"

# ---------------------------------------------------------------------------
# Docker（CLI と Colima は Homebrew で入れる）
# ---------------------------------------------------------------------------
# docker の CLI の設定の置き場所（既定は ~/.docker）。config.json に加えて、Colima が作る
# docker の context（接続先の VM）や、docker login の情報もここに入る。
# Colima 自身は ~/.colima が無ければ $XDG_CONFIG_HOME/colima を使うので、設定しなくてよい。
export DOCKER_CONFIG="$XDG_CONFIG_HOME/docker"
# 接続先を Colima の VM のソケットに固定する。docker の CLI は Colima が作る context でつながるが、
# Testcontainers（Kotlin・Go のテスト）は context を見ず、DOCKER_HOST か /var/run/docker.sock を探すため。
# DOCKER_HOST を設定すると docker の CLI も context より DOCKER_HOST を使う（`docker context use` は効かなくなる）。
# Colima のプロファイルを default 以外にしたら、ここも変えること。
export DOCKER_HOST="unix://$XDG_CONFIG_HOME/colima/default/docker.sock"
# Testcontainers は後片付けをするコンテナ（Ryuk）に docker のソケットをマウントする。そのとき使う、
# VM の中から見たソケットの場所（上の DOCKER_HOST は Mac から見た場所なので、VM の中には無い）
export TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE=/var/run/docker.sock

# ---------------------------------------------------------------------------
# データベースのクライアント（psql・mysql。Homebrew の libpq・mysql-client で入れる）
# ---------------------------------------------------------------------------
# 対話モードの履歴の置き場所（既定は ~/.psql_history・~/.mysql_history）
export PSQL_HISTORY="$XDG_STATE_HOME/psql_history"
export MYSQL_HISTFILE="$XDG_STATE_HOME/mysql_history"

# ---------------------------------------------------------------------------
# SSH エージェント（1Password）
# ---------------------------------------------------------------------------
# ssh 自身は ~/.ssh/config の IdentityAgent で 1Password のエージェントを使うが、VS Code の
# Dev Containers などはコンテナに SSH_AUTH_SOCK のエージェントを渡す。macOS の既定のまま
# （launchd の空のエージェント）だと、コンテナの中の git が鍵を使えないので 1Password に向ける。
# herdr の中では herdr が自分のエージェント（herdr.sock.agent）を設定しているので、上書きしない。
# 1Password が起動していない（ソケットが無い）ときは何もしない。
_op_agent_sock="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
if [[ -S "$_op_agent_sock" && ( -z "$SSH_AUTH_SOCK" || "$SSH_AUTH_SOCK" == /private/tmp/com.apple.launchd.*/Listeners ) ]]; then
  export SSH_AUTH_SOCK="$_op_agent_sock"
fi
unset _op_agent_sock

# ---------------------------------------------------------------------------
# PATH
# ---------------------------------------------------------------------------
typeset -U path fpath

# macOS の /etc/zprofile は path_helper を実行して PATH を /etc/paths から組み直し、
# ここで先頭に置いたパスを末尾へ回してしまう。ログインシェルでは ~/.zprofile が
# path_helper の後に読まれるので、そこからこの関数を呼び直して順序を戻す。
# .zshenv と .zprofile で定義が二重にならないよう関数にまとめている。
#
# .zshenv 側でも PATH を組むのは、スクリプトなど非ログイン・非対話シェルでも
# GNU 版コマンドや mise のツールを使えるようにするため。
_zsh_setup_path() {
  path=(
    "$HOME/.local/bin"
    "${XDG_DATA_HOME}/mise/shims"
    # npm・pnpm・go install でグローバルに入れた実行ファイル。mise のツールの方を優先する
    "$NPM_CONFIG_PREFIX/bin"
    "$PNPM_HOME"
    "$GOPATH/bin"
    # GNU 版コマンド(coreutils / gnu-sed / grep / findutils など)を BSD 版より優先する。
    # gnubin には g 接頭辞なしの名前(ls, sed, grep ...)で入る。(N) は該当なしでもエラーにしない。
    $HOMEBREW_PREFIX/opt/*/libexec/gnubin(N)
    # keg-only（サーバー本体の formula とぶつかるので、Homebrew が bin に入れない）の DB のクライアント
    "$HOMEBREW_PREFIX/opt/libpq/bin"
    "$HOMEBREW_PREFIX/opt/mysql-client/bin"
    "$HOMEBREW_PREFIX/bin"
    "$HOMEBREW_PREFIX/sbin"
    $path
  )
}
_zsh_setup_path


