# 対話シェルでのみ読まれる。環境変数と PATH は .zshenv 側。
#
#   /etc/zshenv → ~/.zshenv → /etc/zprofile → ~/.zprofile → /etc/zshrc → ~/.zshrc

[[ -d "${XDG_STATE_HOME}/zsh" ]] || mkdir -p "${XDG_STATE_HOME}/zsh"
[[ -d "${XDG_CACHE_HOME}/zsh" ]] || mkdir -p "${XDG_CACHE_HOME}/zsh"
[[ -d "${LESSHISTFILE:h}" ]] || mkdir -p "${LESSHISTFILE:h}"

# ---------------------------------------------------------------------------
# ヒストリ
# ---------------------------------------------------------------------------
# /etc/zshrc が HISTFILE=${ZDOTDIR:-$HOME}/.zsh_history を設定するため、
# XDG に寄せるには明示的な上書きが必須（放っておくと ~/.config/zsh/.zsh_history）。
# cache ではなく state に置くのは、消えても壊れないが消えてほしくはないため。
HISTFILE="${XDG_STATE_HOME}/zsh/history"
HISTSIZE=100000   # メモリ上に保持する数
SAVEHIST=100000   # ファイルに保存する数

setopt extended_history         # 実行時刻と所要時間も記録する
setopt inc_append_history_time  # シェル終了時ではなくコマンドごとに追記する
                                # （複数ウインドウの履歴を即座に混ぜたいなら share_history）
setopt hist_ignore_dups         # 直前と同じコマンドは記録しない
setopt hist_ignore_space        # 空白で始めたコマンドは記録しない
setopt hist_reduce_blanks       # 余分な空白を詰めて記録する
setopt hist_find_no_dups        # 検索時に同じ候補を続けて出さない
setopt hist_verify              # !! などのヒストリ展開を即実行せず一度行に出す
setopt hist_no_store            # history コマンド自体は記録しない

# ---------------------------------------------------------------------------
# コマンドラインの入力
# ---------------------------------------------------------------------------
# 打った行・貼り付けた行でも # 以降をコメントとして扱う（zsh の対話シェルの既定はオフで、
# # 以降もコマンドの引数として渡ってしまう）。Claude が出すコメント付きのコマンドをそのまま貼り付けて実行するため。
setopt interactive_comments

# Ctrl+W や Alt+B・Alt+F で単語の一部とみなす記号から / を外す（既定は *?_-.[]~=/&;!#$%^(){}<>）。
# パスを 1 段ずつ消したり移ったりできるようにする（既定では /a/b/c 全体が 1 単語になる）。
WORDCHARS=${WORDCHARS//\//}

# ---------------------------------------------------------------------------
# mise
# ---------------------------------------------------------------------------
# .zshenv で PATH に入れた shims は非対話シェル（スクリプトなど）向け。対話シェルでは
# activate でプロンプトごとに mise hook-env を走らせ、ツールの bin を PATH に直接積み、
# ツールが設定する環境変数（java の JAVA_HOME など）や [env] も反映する。
# shims と activate の併用は mise が想定している構成。
# activate は読み込み時にも hook-env を走らせるので、この後は commands[ツール] がシムでなく
# 実体を指す（補完の生成で使う）。そのため補完より前に置く。
(( $+commands[mise] )) && eval "$(mise activate zsh)"

# ---------------------------------------------------------------------------
# 補完
# ---------------------------------------------------------------------------
# 補完関数は compinit より前に fpath へ足す必要がある。site-functions には各 formula が
# 置いた補完定義が入る。
# fpath は .zshenv で typeset -U 済みなので重複しても消える。
#
# completions には、補完定義を自分で出力するコマンド（mise で入れたものなど）の分を生成して置く。
_zcompdir="${XDG_CACHE_HOME}/zsh/completions"
fpath=(
  "$_zcompdir"
  "${HOMEBREW_PREFIX}/share/zsh/site-functions"
  $fpath
)

_zcompdump="${XDG_CACHE_HOME}/zsh/zcompdump"

# _gencomp <コマンド> <補完を出力するコマンドライン...>
# 生成に使ったコマンドの実体のパスを _<コマンド>.src に記録し、パスが変わったとき（初回・
# バージョンの更新後）だけ生成し直す。mise の実体のパスにはバージョンが入る（…/0.9.5/herdr）。
# 更新日時で比べないのは、アーカイブの日時のまま展開されるツールがあるため（starship など）。
# 生成し直したら zcompdump も消す。下の compinit -C は新しい補完関数を探さないため。
_gencomp() {
  local cmd=$1; shift
  [[ -n ${commands[$cmd]} ]] || return 0
  local src=${commands[$cmd]:A} out="${_zcompdir}/_${cmd}"
  [[ -s $out && -r ${out}.src && $(<${out}.src) == $src ]] && return 0
  [[ -d $_zcompdir ]] || mkdir -p "$_zcompdir"
  if "$@" >| "${out}.tmp" 2>/dev/null && [[ -s ${out}.tmp ]]; then
    mv -f "${out}.tmp" "$out"
    print -r -- "$src" >| "${out}.src"
    rm -f "$_zcompdump"
  else
    rm -f "${out}.tmp"
  fi
}
_gencomp herdr herdr completion zsh
# ghq は補完を出力するコマンドを持たないが、配布物の misc/zsh/_ghq に補完定義が入っている。
_gencomp ghq cat "${commands[ghq]:A:h}/misc/zsh/_ghq"
_gencomp rg rg --generate complete-zsh
_gencomp fd fd --gen-completions zsh
_gencomp bat bat --completion zsh
_gencomp delta delta --generate-completion zsh
_gencomp hunk hunk completion zsh
_gencomp yq yq shell-completion zsh
_gencomp ast-grep ast-grep completions zsh
# zoxide も補完を出力するコマンドを持たないが、配布物の completions/_zoxide に入っている。
_gencomp zoxide cat "${commands[zoxide]:A:h}/completions/_zoxide"
unfunction _gencomp
unset _zcompdir

autoload -Uz compinit
# 生成から 24 時間以内なら -C で fpath の再検証を省いて起動を速くする。
# (#qN.mh-24) = グロブ修飾子。N:該当なしでもエラーにしない mh-24:24時間以内に更新
# [[ ]] の中でグロブ修飾子を効かせる (#q) は extended_glob が要る。無効のままだと文字列のまま残って
# -n が常に真になり、24 時間たっても -C のままになる。シェル全体で有効にすると ^ や # の意味が変わる
# （git reset HEAD^ など）ので、無名関数の中だけで有効にする。
() {
  setopt local_options extended_glob
  if [[ -n ${1}(#qN.mh-24) ]]; then
    compinit -C -d "$1"
  else
    compinit -d "$1"
    # 補完の増減がなければ compinit は zcompdump を書き直さず、日時も古いままになる。
    # そのままだと毎回この重い方に来るので、確かめ終えた印に日時を更新する
    touch "$1"
  fi
} "$_zcompdump"
unset _zcompdump

# eza の配布物には補完定義が入っていないため、zsh 標準の _gnu_generic で --help の出力から
# オプションを拾う。
(( $+commands[eza] )) && compdef _gnu_generic eza

# fzf-tab: <Tab> で出る補完候補の一覧を fzf にして、文字を打って絞り込めるようにする。
# 本体は .chezmoiexternal.toml で clone している。compinit より後、かつ widget を包む
# ほかのプラグイン（zsh-autosuggestions など）より前に読む必要がある。
_fzf_tab="${XDG_DATA_HOME}/zsh/plugins/fzf-tab/fzf-tab.plugin.zsh"
if [[ -r $_fzf_tab ]] && (( $+commands[fzf] )); then
  source "$_fzf_tab"
  # 補完のグループ名（[files] など）を出す。fzf-tab は < > でグループを切り替える。
  zstyle ':completion:*:descriptions' format '[%d]'
  # zsh 標準の選択メニューは使わない（fzf-tab が代わりに出す）
  zstyle ':completion:*' menu no
  # cd の候補では、右側にフォルダの中身を出す。eza が無ければ ls で出す
  # （ls は BSD 版でも GNU 版でも通るオプションだけ使う）。
  if (( $+commands[eza] )); then
    zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1a --icons=always --color=always --group-directories-first -- $realpath'
  else
    zstyle ':fzf-tab:complete:cd:*' fzf-preview 'ls -1A -- $realpath'
  fi
fi
unset _fzf_tab

# ---------------------------------------------------------------------------
# キーバインド
# ---------------------------------------------------------------------------
# emacs キーバインドに固定する。
#
# zsh は起動時、VISUAL か EDITOR の値に "vi" が含まれていれば vi キーバインド(viins)を、
# そうでなければ emacs を選ぶ。.zshenv の EDITOR は nvim で "vi" が
# 引っ掛かるため、明示しないと viins になる(実測: nvim → viins、vim → viins、nano → emacs)。
# viins だと ^P が self-insert のままで履歴を辿れない。
#
# 個別の bindkey を足すときは、この行より後に書くこと(bindkey -e は main キーマップの
# 差し替えなので、先に書いた分は viins 側に入って消える)。
bindkey -e

# Ctrl+X Ctrl+E: 入力中のコマンドを EDITOR（Neovim）で開いて編集する。保存して閉じると行に戻る
# （実行はされないので、確かめてから Enter）。Claude が出す長いコマンドを貼り付けて直すときに使う。
autoload -Uz edit-command-line
zle -N edit-command-line
bindkey '^X^E' edit-command-line

# fzf のシェル連携。次のキーと補完が fzf になる。
#   Ctrl+R: 履歴を検索して行に入れる   Ctrl+T: ファイルを選んで行に入れる
#   **<Tab>: 例 `vim **<Tab>` でファイルを選ぶ
# fzf は読み込んだ時点の <Tab> の widget を覚えて、** でないときはそちらに任せる。
# fzf-tab（補完の節で読む）より後に読むことで、ふだんの <Tab> は fzf-tab のまま使える。
#
# Alt+C（フォルダを選んで cd）は使わない。リポジトリへの移動は下の Ctrl+G で足りる。
# FZF_ALT_C_COMMAND を空にすると fzf はこのキーを割り当てない。
if (( $+commands[fzf] )); then
  # Ctrl+T では、右側に選んでいるファイルの中身を bat で色付きで出す（先頭 500 行）。
  # bat が無ければ head で色なしで出す。フォルダが選ばれているときは中身の一覧を出す（eza が無ければ ls）。
  _dir_preview='ls -1A --' _file_preview='head -n 500 --'
  (( $+commands[eza] )) && _dir_preview='eza -1a --icons=always --color=always --group-directories-first --'
  (( $+commands[bat] )) && _file_preview='bat --color=always --style=numbers --line-range=:500 --'
  FZF_CTRL_T_OPTS="--preview '[[ -d {} ]] && ${_dir_preview} {} || ${_file_preview} {}'"
  unset _dir_preview _file_preview
  FZF_ALT_C_COMMAND= source <(fzf --zsh)
fi

# Ctrl+R のときだけ、ほかのシェル（herdr の別ペインなど）の履歴も検索できるようにする。
# share_history は使わない（↑ や Ctrl+P で遡る履歴は、そのシェルのものだけにしたい）。
# fc -RI で、履歴ファイルからまだ読んでいない分だけを取り込んでから fzf を開く。
# 一度取り込んだ分は、そのシェルの ↑ にも出るようになる。
if (( $+widgets[fzf-history-widget] )); then
  _fzf_history_widget_with_shared() {
    fc -RI
    zle fzf-history-widget
  }
  zle -N _fzf_history_widget_with_shared
  bindkey '^R' _fzf_history_widget_with_shared
fi

# Ctrl+G: ghq で clone したリポジトリを fzf で選んで、そのルートへ cd する。
# 入力途中のコマンドラインはそのまま残す。widget の中の cd ではプロンプトを出し直す前の
# precmd が走らないので、自分で呼んでから reset-prompt する（starship や mise の表示を更新するため）。
_ghq_fzf_cd() {
  local root repo f
  root=$(ghq root 2>/dev/null) || return
  repo=$(ghq list | fzf --height=40% --reverse --prompt='repo> ' \
    --preview="git -C ${(q)root}/{} log --oneline --color=always -10") || { zle reset-prompt; return }
  cd -- "${root}/${repo}" || { zle reset-prompt; return }
  for f in $precmd_functions; do "$f"; done
  zle reset-prompt
}
if (( $+commands[ghq] && $+commands[fzf] )); then
  zle -N _ghq_fzf_cd
  bindkey '^G' _ghq_fzf_cd
fi

# ---------------------------------------------------------------------------
# zoxide
# ---------------------------------------------------------------------------
# cd したフォルダを記録しておき、`z <名前の一部>` で行った回数と最近さが一番のものへ移動する。
# `zi` は候補を fzf で選ぶ。cd は置き換えない。Ctrl+G で移動したリポジトリも記録される
# （記録は cd のたびに走る chpwd フックで行うため）。
# 記録の置き場所は、指定しないと macOS では ~/Library/Application Support/zoxide になるので
# XDG に寄せる。z の引数の補完を登録するため compinit より後に読む。
if (( $+commands[zoxide] )); then
  export _ZO_DATA_DIR="${XDG_DATA_HOME}/zoxide"
  eval "$(zoxide init zsh)"
fi

# ---------------------------------------------------------------------------
# 入力の補助
# ---------------------------------------------------------------------------
# zsh-autosuggestions: 入力中のコマンドの続きを履歴から薄く出す。→ か Ctrl+E（行末へ移動）で
# 全部、Alt+F（単語ごとに進む）でその単語まで確定する。
# 本体は .chezmoiexternal.toml で clone している。キーの widget を包むので、fzf-tab や
# 上のキーバインドより後に読む（プロンプトのたびに包み直すので、多少前後しても壊れない）。
_zsh_autosuggest="${XDG_DATA_HOME}/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh"
[[ -r $_zsh_autosuggest ]] && source "$_zsh_autosuggest"
unset _zsh_autosuggest

# ---------------------------------------------------------------------------
# エイリアス
# ---------------------------------------------------------------------------
# ll: 隠しファイルも含めて詳しく一覧する。git 管理下なら各ファイルの状態も出す。
# ls は置き換えない（スクリプトやほかの人の手順にある ls のオプションとの違いで迷わないため）。
# エイリアスでなく関数にして、引数が無ければ . を渡す。eza（0.23.5 で確認）は --git 付きで
# 引数を省くと、git リポジトリのルートでは何も出さずに終わるため（. を明示すれば出る）。
if (( $+commands[eza] )); then
  ll() { eza -la --git --icons=auto --group-directories-first -- "${@:-.}" }

  # tree: 隠しファイルも含めて深さ 2 までをツリーで出す。依存やビルド結果などは除く。
  # 後から付けた -L は前の指定を上書きする（tree -L 3 で深くできる）。
  # -I も上書きなので、tree -I '...' と付けると下の除外は効かなくなる。
  alias tree="eza -Ta -L 2 --icons=auto --group-directories-first -I '.git|node_modules|.venv|venv|__pycache__|.DS_Store|.next|.gradle|.idea|target|dist|build|coverage'"
fi

# vim: 癖で打っても macOS 標準の Vim でなく Neovim を開く（設定は ~/.config/nvim にしかないため）。
# 標準の Vim を使いたいときは \vim か command vim で呼べる。
(( $+commands[nvim] )) && alias vim=nvim

# ---------------------------------------------------------------------------
# プロンプト
# ---------------------------------------------------------------------------
# 見た目は ~/.config/starship.toml で設定する。starship は mise で入れているので、
# mise activate より後に書く。
(( $+commands[starship] )) && eval "$(starship init zsh)"

# ---------------------------------------------------------------------------
# シンタックスハイライト（必ず最後）
# ---------------------------------------------------------------------------
# zsh-syntax-highlighting: 入力中のコマンドラインを色分けする。存在しないコマンドは赤、
# 打ち間違いが実行前に分かる。本体は .chezmoiexternal.toml で clone している。
# 読んだ時点で定義済みの widget を包むので、ほかの widget（fzf、zsh-autosuggestions など）を
# すべて定義した後、.zshrc の最後で読む必要がある。
_zsh_syntax_highlighting="${XDG_DATA_HOME}/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
[[ -r $_zsh_syntax_highlighting ]] && source "$_zsh_syntax_highlighting"
unset _zsh_syntax_highlighting
