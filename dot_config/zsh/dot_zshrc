# 対話シェルでのみ読まれる。環境変数と PATH は .zshenv 側。
#
#   /etc/zshenv → ~/.zshenv → /etc/zprofile → ~/.zprofile → /etc/zshrc → ~/.zshrc
#
# macOS の /etc/zshrc は ~/.zshrc の直前に読まれ、HISTFILE / HISTSIZE / SAVEHIST /
# PS1 / BEEP / ↑↓ のキーバインドを問答無用で設定する。以下の上書きはそれが前提。

# zsh が書き出すファイルの置き場。run_once_before_01-xdg-dirs.sh でも作っているが、
# ここが無いとヒストリが黙って捨てられるので .zshrc 単体でも成立させておく。
# [[ ]] は組み込みなので、既にあれば fork は発生しない。
[[ -d "${XDG_STATE_HOME}/zsh" ]] || mkdir -p "${XDG_STATE_HOME}/zsh"
[[ -d "${XDG_CACHE_HOME}/zsh" ]] || mkdir -p "${XDG_CACHE_HOME}/zsh"
[[ -d "${LESSHISTFILE:h}" ]] || mkdir -p "${LESSHISTFILE:h}"

# ---------------------------------------------------------------------------
# ヒストリ
#
# /etc/zshrc が HISTFILE=${ZDOTDIR:-$HOME}/.zsh_history を設定するため、
# XDG に寄せるには明示的な上書きが必須（放っておくと ~/.config/zsh/.zsh_history）。
# cache ではなく state に置くのは、消えても壊れないが消えてほしくはないため。
HISTFILE="${XDG_STATE_HOME}/zsh/history"
HISTSIZE=100000   # メモリ上に保持する数
SAVEHIST=100000   # ファイルに保存する数

setopt extended_history         # 実行時刻と所要時間も記録する
setopt inc_append_history_time  # シェル終了時ではなくコマンドごとに追記する
                                # （複数ウインドウの履歴を即座に混ぜたいなら share_history）
setopt hist_ignore_dups         # 直前と同じコマンドは記録しない
setopt hist_ignore_space        # 空白で始めたコマンドは記録しない
setopt hist_reduce_blanks       # 余分な空白を詰めて記録する
setopt hist_find_no_dups        # 検索時に同じ候補を続けて出さない
setopt hist_verify              # !! などのヒストリ展開を即実行せず一度行に出す
setopt hist_no_store            # history コマンド自体は記録しない

# ---------------------------------------------------------------------------
# シェルの挙動
setopt auto_cd                # ディレクトリ名だけで cd する（.. や - も効く）
setopt auto_pushd             # cd を自動で pushd し、cd -<Tab> で戻れる
setopt pushd_ignore_dups
setopt pushd_silent           # pushd/popd でスタックを表示しない
DIRSTACKSIZE=20

setopt extended_glob          # ^ ~ # をグロブで使う（(N) や (.mh-24) もこれ）
setopt interactive_comments   # 対話シェルでも # 以降をコメント扱いにする
setopt no_beep                # /etc/zshrc の setopt BEEP を打ち消す
setopt no_flow_control        # ^S/^Q のフロー制御を切って ^S を使えるようにする

# ---------------------------------------------------------------------------
# 補完
#
# 補完関数は compinit より前に fpath へ足す必要がある。site-functions は各 formula が
# 置く分、zsh-completions は zsh 本体に同梱されない補完定義集（別ディレクトリ）。
# fpath は .zshenv で typeset -U 済みなので重複しても消える。
fpath=(
  "${HOMEBREW_PREFIX}/share/zsh/site-functions"
  "${HOMEBREW_PREFIX}/share/zsh-completions"
  $fpath
)

autoload -Uz compinit
_zcompdump="${XDG_CACHE_HOME}/zsh/zcompdump"
# 生成から 24 時間以内なら -C で fpath の再検証を省いて起動を速くする。
# (#qN.mh-24) = グロブ修飾子。N:該当なしでもエラーにしない mh-24:24時間以内に更新
if [[ -n ${_zcompdump}(#qN.mh-24) ]]; then
  compinit -C -d "$_zcompdump"
else
  compinit -d "$_zcompdump"
fi
unset _zcompdump

# 候補選択は fzf-tab に任せるので zsh 本体のメニューは出さない。
# menu select のままだと fzf-tab が候補を横取りできず、両方が二重に効く。
zstyle ':completion:*' menu no
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}' # 小文字入力で大文字にもマッチ
zstyle ':completion:*' group-name ''                # 種類ごとに候補をまとめる
zstyle ':completion:*:descriptions' format '%F{yellow}%B%d%b%f'
# AWS CLI v2 は zsh 用の補完関数を持たず、bash 互換の completer を呼ぶ方式。
# bashcompinit を読んでから complete -C で登録する（compinit の後であること）。
# aws_completer は mise の shim として PATH に居るので絶対パスは書かない。
if (( $+commands[aws_completer] )); then
  autoload -Uz bashcompinit && bashcompinit
  complete -C aws_completer aws
fi

zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "${XDG_CACHE_HOME}/zsh/zcompcache"

# ---------------------------------------------------------------------------
# キーバインド
bindkey -e   # emacs キーバインド（EDITOR に依存させない）

# ↑↓ を「入力済みの文字に前方一致するヒストリ検索」にする。
# /etc/zshrc が terminfo 経由で up-line-or-search を割り当てているのを上書きする。
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search    # ↑（ノーマルモード）
bindkey '^[OA' up-line-or-beginning-search    # ↑（アプリケーションモード）
bindkey '^[[B' down-line-or-beginning-search  # ↓
bindkey '^[OB' down-line-or-beginning-search

# ---------------------------------------------------------------------------
# エイリアス
#
# --color=auto は BSD 版（macOS 標準）・GNU 版（coreutils）どちらの ls も解する。
# PATH の gnubin が効いていれば GNU 版が使われる。
alias ls='ls --color=auto'
alias ll='ls -lh'
alias la='ls -lha'
alias grep='grep --color=auto'

# tree は macOS に入っていないので eza で代用する（実体は mise の [tools]）。
# ls / ll / la は GNU 版のまま。eza に寄せると --color 以外のフラグも
# 別物になるので、今は tree だけを置き換えている。
#
# alias ではなく関数なのは、eza 0.23.5 が「パス引数が無く、かつ出力先が端末でない」
# とき、終了コード 0 のまま何も出力しないため（eza-community/eza#1568、未修正）。
# `tree | head` が黙って空になるので、パスらしき引数が無ければ . を補う。
# 素の eza を使いたいときは `command eza`（関数は \tree では回避できない）。
tree() {
  local a
  for a in "$@"; do
    # 実在するパスを指す引数が既にあるなら補う必要は無い
    [[ $a != -* && -e $a ]] && { command eza --tree "$@"; return }
  done
  command eza --tree "$@" .
}

# ---------------------------------------------------------------------------
# プロンプト
#
# /etc/zshrc の PS1="%n@%m %1~ %# " を上書きする。
# vcs_info は precmd ごとに git を呼ぶが、check-for-changes（変更の有無 %u%c）は
# 大きなリポジトリで目に見えて遅くなるので有効にしていない。
autoload -Uz vcs_info
zstyle ':vcs_info:*' enable git
zstyle ':vcs_info:git:*' formats ' %F{magenta}%b%f'
zstyle ':vcs_info:git:*' actionformats ' %F{magenta}%b%f|%F{red}%a%f'
_precmd_vcs_info() { vcs_info; }
precmd_functions+=(_precmd_vcs_info)

setopt prompt_subst  # ${vcs_info_msg_0_} をプロンプト描画のたびに展開する
# 1 行目にパスと git ブランチ、2 行目に入力欄。直前が異常終了なら % が赤くなる。
PROMPT='%F{cyan}%~%f${vcs_info_msg_0_}
%(?.%F{green}.%F{red})%#%f '

# ---------------------------------------------------------------------------
# プラグイン
#
# 実体は mise の [bootstrap.packages]（brew: の formula）で入れている。
# プラグインマネージャは使わない。読み込み順に次の制約があり、
# 1 箇所に並べたほうが追えるため。
#
#   1. zsh-completions      fpath に足すだけ。compinit より前（上の補完節で済ませている）
#   2. fzf-tab              compinit の後。補完ウィジェットを置き換えるため
#   3. fzf                  ウィジェットを定義する側なので、包む側より先に読む
#   4. zsh-autosuggestions  既存ウィジェットをラップする
#   5. zsh-syntax-highlighting  同上。他プラグインのウィジェットも包むので必ず最後
#
# この節をプロンプト節より後に置いているのは、5 を確実にファイル末尾にするため。
# プロンプト（vcs_info）は precmd フックだけでウィジェットを作らないので順序に絡まない。
#
# 未導入のマシン（mise bootstrap 前）でも .zshrc が壊れないよう -r で守る。

# 補完候補を fzf の絞り込みで選ぶ。上の `menu no` とセット。
[[ -r "${HOMEBREW_PREFIX}/share/fzf-tab/fzf-tab.zsh" ]] &&
  source "${HOMEBREW_PREFIX}/share/fzf-tab/fzf-tab.zsh"
zstyle ':fzf-tab:*' switch-group '<' '>'   # 候補グループを < > で切り替える
# cd の候補をプレビューする。$realpath は fzf-tab が候補ごとに渡す変数（zsh の
# 同名パラメータではない）ので、展開させずシングルクォートで渡すこと。
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza --oneline --color=always $realpath'

# Ctrl-R 履歴検索 / Ctrl-T ファイル選択 / Alt-C ディレクトリ移動。
# fzf 0.48 以降は本体が `--zsh` でキーバインドを吐くので、配布物の
# shell/key-bindings.zsh を探して読む必要は無い（mise で入れた fzf には同梱されない）。
#
# fzf も ^I を fzf-completion に奪うが、読み込み時に既存の ^I バインドを
# fzf_default_completion として控え、`**` トリガが無いときはそちらへ委譲する。
# fzf-tab を先に読んであるので、素の Tab は fzf-tab、`**`+Tab は fzf のパス補完になる。
#
# 候補の列挙を find から fd に差し替える。fzf の既定は find なので、
# そのままだと Ctrl-T が node_modules や .git まで舐めて使いものにならない。
# fd は .gitignore を既定で尊重する。--hidden はドットファイルも対象にする指定で、
# .git だけは明示的に外す（中を見たいことはまず無いため）。
#
# FZF_* を .zshenv ではなくここに置いているのは、Ctrl-T / Alt-C 用の設定と
# 同じ場所に並べたほうが読めるため。fzf を使うのは対話シェルだけでもある。
if (( $+commands[fd] )); then
  export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  export FZF_ALT_C_COMMAND='fd --type d --hidden --exclude .git'
fi
# Ctrl-T の候補をプレビューする。--style=numbers で行番号だけ付ける。
(( $+commands[bat] )) && \
  export FZF_CTRL_T_OPTS='--preview "bat --color=always --style=numbers {}"'

(( $+commands[fzf] )) && eval "$(fzf --zsh)"

# Ctrl-G: rg で「中身」を全文検索し、選んだファイルのパスをコマンドラインに挿す。
# Ctrl-T（fzf + fd）がファイル名を探すのに対し、こちらは中身を探す担当。
#
# fzf 側の絞り込みは無効化し（--disabled）、入力が変わるたびに rg を回し直す
# （change:reload）。fzf に全行を食わせて絞るのではなく、検索そのものを rg に
# やらせる形。{q} は fzf が現在の入力をクォートして埋めてくれる。
# sleep 0.1 は 1 文字ごとに rg を起動しないための間引き（fzf 公式の例と同じ）。
#
# 既定の ^G は send-break（zle の中断）。中断は ^C が残るので潰している。
if (( $+commands[rg] && $+commands[fzf] && $+commands[bat] )); then
  _fzf_rg_widget() {
    local rg_cmd='rg --line-number --no-heading --color=always --smart-case --hidden --glob "!.git" -- {q} || true'
    local selected
    # 初期表示は空にする（空パターンの rg は全行に当たって重いため）。
    selected=$(FZF_DEFAULT_COMMAND=true fzf \
      --ansi --disabled --delimiter : \
      --bind "change:reload:sleep 0.1; ${rg_cmd}" \
      --preview 'bat --color=always --style=numbers --highlight-line {2} -- {1}' \
      --preview-window 'right,60%,+{2}+3/3' \
      | cut -d: -f1)
    if [[ -n $selected ]]; then
      # 行番号はプレビューで見えるので、挿すのはそのまま他のコマンドに渡せるパスだけ。
      LBUFFER+="${selected} "
    fi
    zle reset-prompt
  }
  zle -N _fzf_rg_widget
  bindkey '^G' _fzf_rg_widget
fi

# cd 履歴へのジャンプ（z <部分文字列> / zi で候補選択）。補完を compdef で
# 登録するので compinit の後に置く。zi の候補選択には fzf が使われる。
# cd 自体は置き換えない（--cmd cd を付けていない）ので、既存の auto_cd や
# ../- はそのまま効く。
(( $+commands[zoxide] )) && eval "$(zoxide init zsh)"

# 履歴からインラインで候補をサジェストする（灰色表示 / → または End で確定）。
[[ -r "${HOMEBREW_PREFIX}/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]] &&
  source "${HOMEBREW_PREFIX}/share/zsh-autosuggestions/zsh-autosuggestions.zsh"

# 入力中のコマンドラインをシンタックスハイライトする（存在しないコマンドは赤）。
[[ -r "${HOMEBREW_PREFIX}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]] &&
  source "${HOMEBREW_PREFIX}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
