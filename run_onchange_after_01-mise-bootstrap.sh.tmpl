#!/usr/bin/env bash
{{ template "lib.sh" }}
{{ template "xcode.sh" }}

# config.toml のハッシュを埋め込んで、設定を変えたときだけ再実行させる。
# mise config sha256: {{ include "dot_config/mise/config.toml" | sha256sum }}

export PATH="${HOME}/.local/bin:${PATH}"

command -v mise >/dev/null 2>&1 || { echo "mise が見つかりません (before 03 が失敗している)" >&2; exit 1; }

# リポジトリ内のソース設定を mise の探索対象から外す。
#
# mise はカレントから親を遡って mise/config.toml を探すため、chezmoi のソースにある
# dot_config/mise/config.toml（配置前のこのリポジトリ自身のファイル）をプロジェクト
# 設定として拾う。postinstall や tasks を含む設定には trust が要るので untrusted
# エラーになり、**リポジトリ内に cd している間 mise の shim が軒並み落ちる**
# (rg / fd / eza / docker …)。
#
# 下の mise install より前に置くこと。mise install は「実行対象の設定を自動で trust
# する」ので、順序が逆だとソース側の設定が trust されて二重に読まれる。
# 設定ファイルの settings.ignored_config_paths でも同じことを狙えるが、
# 設定の読み込み順の都合で効かなかった（環境変数 MISE_IGNORED_CONFIG_PATHS なら効く）。
# 記録先は ~/.local/state/mise/ignored-configs で、冪等に何度でも実行してよい。
log "mise trust --ignore (chezmoi のソース設定)"
mise trust --ignore "{{ .chezmoi.sourceDir }}/dot_config/mise/config.toml" >/dev/null

# [tools] の言語ランタイム・CLI
log "mise install"
mise install

# [bootstrap.packages] のホストパッケージ。os キーで OS ごとに絞られる。
{{ if eq .chezmoi.os "darwin" -}}
# packages apply は開始時に変更履歴の git リポジトリを開くので、Xcode が入っていてライセンス
# 未同意だと何もせずに落ちる(App Store で Xcode が更新された後など)。先に済ませておく。
# 今回の apply で Xcode が入る場合は、直後の 02-xcode がセットアップする。
setup_xcode

# mas(App Store アプリ)は root でないとき自分で sudo を呼び直す(mas 7)。mise は mas の
# 出力を取り込むので、途中でパスワードを聞かれても何の入力か分からない。そこで入れる
# App Store アプリがあるときだけ、02-homebrew と同じく先に認証して延長し続ける。
# 他のマネージャ(brew-cask など)を処理している間に既定タイムアウト(5 分)を超えうるため
# keepalive も置く。
# dry-run は入れるものがあると `mas install <id>…` を標準出力に出し、無ければ何も出さない。
if [[ -n "$(mise bootstrap packages apply --dry-run --manager mas 2>/dev/null)" ]]; then
  if ! sudo -n true 2>/dev/null; then
    log "sudo の認証（App Store アプリのインストールに必要）"
    if ! sudo -v; then
      echo "sudo の認証に失敗しました。管理者アカウントで実行してください。" >&2
      exit 1
    fi
  fi
  # 入出力を切り離す理由と、trap で子→親の順に落とす理由は 02-homebrew を参照。
  while kill -0 "$$" 2>/dev/null && sudo -n true 2>/dev/null; do sleep 30; done \
    </dev/null >/dev/null 2>&1 &
  sudo_keepalive_pid=$!
  trap 'pkill -P "${sudo_keepalive_pid}" 2>/dev/null; kill "${sudo_keepalive_pid}" 2>/dev/null; true' EXIT
fi
{{ end -}}
log "mise bootstrap packages apply"
mise bootstrap packages apply --yes

{{ if eq .chezmoi.os "darwin" -}}
# compinit のダンプを捨てて次のシェル起動で作り直させる。
# .zshrc は 24 時間以内のダンプなら -C で fpath を再検証しないため、
# 消さないと今入れた formula の補完が最大 1 日出てこない。
rm -f "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump"
{{ end -}}
